# Public HTTP endpoint
VMQ_HTTP_PORT=8080

# Initial administrator. Change both password placeholders before starting.
VMQ_ADMIN_USER=admin
VMQ_ADMIN_PASSWORD=change_me_to_a_long_random_admin_password

# PostgreSQL
POSTGRES_DB=vmq
POSTGRES_USER=vmq
POSTGRES_PASSWORD=change_me_to_a_long_random_database_password

# Schema management. Keep "update" for first-time evaluation deployments.
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_FLYWAY_ENABLED=false

