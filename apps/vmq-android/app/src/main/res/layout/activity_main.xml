<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    tools:context="com.vone.vmq.MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingTop="12dp"
            android:paddingRight="18dp"
            android:paddingBottom="22dp">

            <include layout="@layout/toolbar_main" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_hero_card"
                android:elevation="8dp"
                android:orientation="vertical"
                android:paddingLeft="18dp"
                android:paddingTop="16dp"
                android:paddingRight="18dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_chip_success"
                            android:paddingLeft="10dp"
                            android:paddingTop="5dp"
                            android:paddingRight="10dp"
                            android:paddingBottom="5dp"
                            android:text="实时监听"
                            android:textColor="@color/modernSuccess"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="收款通知稳定同步"
                            android:textColor="@color/modernTextPrimary"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="扫码或手动配置后即可检测监听状态"
                            android:textColor="@color/modernTextSecondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginLeft="12dp"
                        android:background="@drawable/bg_logo_mark"
                        android:gravity="center"
                        android:text="¥"
                        android:textColor="@android:color/white"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_qrcode"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginRight="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_primary_button"
                        android:minHeight="0dp"
                        android:onClick="startQrCode"
                        android:text="扫码配置"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_input"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginLeft="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_secondary_button"
                        android:minHeight="0dp"
                        android:onClick="doInput"
                        android:text="手动配置"
                        android:textAllCaps="false"
                        android:textColor="@color/modernPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_start"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginRight="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_outline_button"
                        android:minHeight="0dp"
                        android:onClick="doStart"
                        android:text="检测心跳"
                        android:textAllCaps="false"
                        android:textColor="@color/modernTextPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_checkpush"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginLeft="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_outline_button"
                        android:minHeight="0dp"
                        android:onClick="checkPush"
                        android:text="检测监听"
                        android:textAllCaps="false"
                        android:textColor="@color/modernTextPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_glass_card"
                android:elevation="6dp"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingTop="14dp"
                android:paddingRight="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="当前配置"
                    android:textColor="@color/modernTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_host"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_info_row"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:paddingLeft="12dp"
                    android:paddingTop="10dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="10dp"
                    android:text=" 通知地址：请扫码配置"
                    android:textColor="@color/modernTextPrimary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txt_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_info_row"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:paddingLeft="12dp"
                    android:paddingTop="10dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="10dp"
                    android:text=" 通讯密钥：请扫码配置"
                    android:textColor="@color/modernTextPrimary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txt_keep_alive_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_status_chip_warning"
                    android:paddingLeft="12dp"
                    android:paddingTop="10dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="10dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text=" 保活服务：等待启动"
                    android:textColor="@color/modernWarning"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_runtime_logs"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_outline_button"
                        android:minHeight="0dp"
                        android:onClick="showRuntimeLogs"
                        android:text="查看运行日志"
                        android:textAllCaps="false"
                        android:textColor="@color/modernTextPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_glass_card"
                android:elevation="6dp"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingTop="14dp"
                android:paddingRight="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="防杀后台设置"
                    android:textColor="@color/modernTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="为防止系统杀死 App，建议完成以下设置"
                    android:textColor="@color/modernTextSecondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginRight="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_setting_button"
                        android:minHeight="0dp"
                        android:onClick="openBatteryOptimizationSettings"
                        android:text="🔋 关闭电池优化"
                        android:textAllCaps="false"
                        android:textColor="@color/modernTextPrimary"
                        android:textSize="13sp" />

                    <Button
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginLeft="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_setting_button"
                        android:minHeight="0dp"
                        android:onClick="showLockBackgroundGuide"
                        android:text="🔒 锁定后台"
                        android:textAllCaps="false"
                        android:textColor="@color/modernTextPrimary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginRight="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_setting_button"
                        android:minHeight="0dp"
                        android:onClick="openAutoStartSettings"
                        android:text="🚀 允许自启动"
                        android:textAllCaps="false"
                        android:textColor="@color/modernTextPrimary"
                        android:textSize="13sp" />

                    <Button
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginLeft="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_setting_button"
                        android:minHeight="0dp"
                        android:onClick="openPaymentNotificationSettings"
                        android:text="🔔 通知权限"
                        android:textAllCaps="false"
                        android:textColor="@color/modernTextPrimary"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_setting_button"
                    android:minHeight="0dp"
                    android:onClick="openExactAlarmSettings"
                    android:text="⏰ 允许精准闹钟"
                    android:textAllCaps="false"
                    android:textColor="@color/modernTextPrimary"
                    android:textSize="13sp" />

                <Button
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_setting_button"
                    android:minHeight="0dp"
                    android:onClick="openPowerSaveSettings"
                    android:text="⚡ 关闭系统省电模式"
                    android:textAllCaps="false"
                    android:textColor="@color/modernTextPrimary"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
